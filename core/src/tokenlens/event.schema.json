{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "timestamp",
    "provider",
    "source",
    "scope",
    "synthetic",
    "task",
    "execution",
    "usage",
    "assessment"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "enum": [
        "codex",
        "claude_code",
        "antigravity",
        "other"
      ]
    },
    "source": {
      "enum": [
        "codex_exec",
        "claude_result",
        "claude_statusline",
        "manual",
        "synthetic"
      ]
    },
    "scope": {
      "enum": [
        "request",
        "turn",
        "run",
        "context_snapshot"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "complexity",
        "classification_source"
      ],
      "properties": {
        "category": {
          "enum": [
            "unknown",
            "coding",
            "debugging",
            "refactor",
            "research",
            "planning",
            "other"
          ]
        },
        "complexity": {
          "enum": [
            "unknown",
            "low",
            "medium",
            "high"
          ]
        },
        "classification_source": {
          "enum": [
            "unknown",
            "manual"
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "reasoning_level",
        "duration_ms",
        "success"
      ],
      "properties": {
        "model": {
          "enum": [
            null,
            "gpt-5",
            "gpt-5-codex",
            "gpt-5.1",
            "gpt-5.1-codex",
            "gpt-5.2",
            "gpt-5.2-codex",
            "gpt-5.3-codex",
            "gpt-5.4",
            "gpt-5.5",
            "gpt-6-astra",
            "gpt-6-sol",
            "gpt-6-luna",
            "claude-opus-4-6",
            "claude-sonnet-4-6",
            "claude-opus-4-5-20251101",
            "claude-sonnet-4-5-20250929",
            "claude-haiku-4-5-20251001",
            "gemini-2.5-pro",
            "gemini-2.5-flash",
            "gemini-3-pro-preview",
            "gemini-3.1-pro-preview"
          ]
        },
        "reasoning_level": {
          "enum": [
            null,
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000
        },
        "success": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "cache_creation_tokens",
        "reasoning_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000
        },
        "cache_creation_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_fit"
      ],
      "properties": {
        "model_fit": {
          "enum": [
            "unknown"
          ]
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TokenLens safe event 1.0"
}
